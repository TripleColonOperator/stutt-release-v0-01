{
  "openai_compatible": [
    {
      "name": "nvidia-local-stack",
      "model": "nvidia/llama-3.1-nemotron-nano-4b-instruct",
      "base_url": "http://localhost:8000",
      "api_key_env": "NVIDIA_API_KEY",
